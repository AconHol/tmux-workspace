<Page x:Class="TerminalApp.TerminalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:TerminalApp"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mtu="using:Microsoft.Terminal.UI"
      xmlns:mux="using:Microsoft.UI.Xaml.Controls"
      Background="Transparent"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TmuxSidebarEdgeBrush" Color="#FF3A424C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TmuxSidebarEdgeBrush" Color="#FFCDD2D8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TmuxSidebarEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="Root"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:TabRowControl x:Name="TabRow"
                             Grid.Row="0"
                             Grid.ColumnSpan="2"
                             KeyUp="_KeyDownHandler" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <mux:InfoBar x:Name="CloseOnExitInfoBar"
                         x:Uid="CloseOnExitInfoBar"
                         x:Load="False"
                         CornerRadius="0"
                         IsClosable="True"
                         IsIconVisible="True"
                         IsOpen="False"
                         Severity="Informational">
                <mux:InfoBar.ActionButton>
                    <Button x:Uid="InfoBarDismissButton"
                            Click="_CloseOnExitInfoDismissHandler" />
                </mux:InfoBar.ActionButton>
            </mux:InfoBar>
            <mux:InfoBar x:Name="TmuxProblem" IsOpen="False" IsClosable="False" Severity="Warning">
                <mux:InfoBar.ActionButton>
                    <Button x:Name="TmuxProblemAction" Click="_TmuxProblemActionClicked" Content="打开 SSH 终端" />
                </mux:InfoBar.ActionButton>
            </mux:InfoBar>
        </StackPanel>

        <SplitView x:Name="TmuxWorkspaceView" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed"
                   DisplayMode="CompactInline" IsPaneOpen="True" OpenPaneLength="280" CompactPaneLength="48"
                   PanePlacement="Left" PaneBackground="Transparent" Background="Transparent">
            <SplitView.Pane>
                <Border x:Name="TmuxSidebar" Width="280"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Button x:Name="TmuxSidebarToggle" Width="40" Height="40" Margin="4"
                                      HorizontalAlignment="Left" Click="_TmuxToggleSidebarClicked"
                                      Style="{ThemeResource TmuxSubtleButtonStyle}"
                                      AutomationProperties.Name="折叠会话侧栏" ToolTipService.ToolTip="折叠会话侧栏">
                            <FontIcon Glyph="&#xE700;" FontSize="16" />
                        </Button>
                    <Grid x:Name="TmuxSidebarBody" Grid.Row="1" Margin="16,8,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="服务器" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TmuxServerHeading" Style="{ThemeResource SubtitleTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Style="{ThemeResource TmuxSubtleButtonStyle}"
                                    AutomationProperties.Name="服务器选项" ToolTipService.ToolTip="服务器选项">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="打开 SSH 终端" Click="_TmuxVerifySshClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="切换服务器" Click="_TmuxSwitchServerClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TmuxNewButton" HorizontalAlignment="Stretch"
                                    Style="{ThemeResource AccentButtonStyle}" Click="_TmuxNewSessionClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="新建会话" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TmuxRefreshButton" Grid.Column="1" Margin="8,0,0,0"
                                    AutomationProperties.Name="刷新会话" ToolTipService.ToolTip="刷新会话"
                                    Click="_TmuxRefreshClicked">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                        </Grid>
                        <TextBox x:Name="TmuxSessionSearch" Grid.Row="2" PlaceholderText="搜索会话"
                                 AutomationProperties.Name="搜索会话" TextChanged="_TmuxSearchChanged" Margin="0,0,0,8" />
                        <ListView x:Name="TmuxSessionList" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True"
                                  ItemClick="_TmuxSessionClicked" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="远端 tmux 会话" />
                        <StackPanel Grid.Row="4" Spacing="8" Margin="0,12,0,0">
                            <ProgressBar x:Name="TmuxLoading" IsIndeterminate="True" Visibility="Collapsed" />
                            <TextBlock x:Name="TmuxStatus" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            <UserControl x:Name="TmuxTools" IsEnabled="False">
                            <StackPanel Spacing="6">
                                <TextBlock Text="当前会话" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Button Tag="split-horizontal" Click="_TmuxActionClicked" HorizontalAlignment="Stretch" Margin="0,0,3,6" Content="左右分屏" ToolTipService.ToolTip="在 tmux 中左右分屏" />
                                    <Button Grid.Column="1" Tag="split-vertical" Click="_TmuxActionClicked" HorizontalAlignment="Stretch" Margin="3,0,0,6" Content="上下分屏" ToolTipService.ToolTip="在 tmux 中上下分屏" />
                                    <Button Grid.Row="1" Tag="next-pane" Click="_TmuxActionClicked" HorizontalAlignment="Stretch" Margin="0,0,3,6" Content="切换焦点" ToolTipService.ToolTip="循环切换 tmux 窗格焦点" />
                                    <Button Grid.Row="1" Grid.Column="1" Tag="zoom-pane" Click="_TmuxActionClicked" HorizontalAlignment="Stretch" Margin="3,0,0,6" Content="放大 / 还原" ToolTipService.ToolTip="放大或还原当前 tmux 窗格" />
                                    <Button Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,0,3,0" Content="更多操作">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="新建 tmux 窗口" Tag="new-window" Click="_TmuxActionClicked" />
                                                <MenuFlyoutItem Text="上一个窗口" Tag="previous-window" Click="_TmuxActionClicked" />
                                                <MenuFlyoutItem Text="下一个窗口" Tag="next-window" Click="_TmuxActionClicked" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="切换分屏布局" Tag="next-layout" Click="_TmuxActionClicked" />
                                                <MenuFlyoutItem Text="查看滚动历史" Tag="copy-mode" Click="_TmuxActionClicked" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="1" Click="_TmuxTranslateClicked" HorizontalAlignment="Stretch" Margin="3,0,0,0" Content="AI 翻译" ToolTipService.ToolTip="翻译文字并填入当前终端" />
                                </Grid>
                            </StackPanel>
                            </UserControl>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource TmuxSubtleButtonStyle}"
                                    Click="_TmuxPersonalizationClicked">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                                    <TextBlock Text="个性化" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                        <Grid x:Name="TmuxSidebarRail" Grid.Row="1" Width="48" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel>
                                <Button Width="40" Height="40" Margin="4" Click="_TmuxNewSessionClicked"
                                        Style="{ThemeResource TmuxSubtleButtonStyle}" AutomationProperties.Name="新建会话"
                                        ToolTipService.ToolTip="新建会话"><FontIcon Glyph="&#xE710;" FontSize="16" /></Button>
                                <Button Width="40" Height="40" Margin="4" Click="_TmuxRefreshClicked"
                                        Style="{ThemeResource TmuxSubtleButtonStyle}" AutomationProperties.Name="刷新会话"
                                        ToolTipService.ToolTip="刷新会话"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <Button x:Name="TmuxRailTools" Width="40" Height="40" Margin="4" IsEnabled="False"
                                        Style="{ThemeResource TmuxSubtleButtonStyle}" AutomationProperties.Name="tmux 快捷操作" ToolTipService.ToolTip="tmux 快捷操作">
                                    <FontIcon Glyph="&#xE80A;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="左右分屏" Tag="split-horizontal" Click="_TmuxActionClicked" />
                                            <MenuFlyoutItem Text="上下分屏" Tag="split-vertical" Click="_TmuxActionClicked" />
                                            <MenuFlyoutItem Text="切换焦点" Tag="next-pane" Click="_TmuxActionClicked" />
                                            <MenuFlyoutItem Text="放大 / 还原窗格" Tag="zoom-pane" Click="_TmuxActionClicked" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="新建 tmux 窗口" Tag="new-window" Click="_TmuxActionClicked" />
                                            <MenuFlyoutItem Text="上一个窗口" Tag="previous-window" Click="_TmuxActionClicked" />
                                            <MenuFlyoutItem Text="下一个窗口" Tag="next-window" Click="_TmuxActionClicked" />
                                            <MenuFlyoutItem Text="切换分屏布局" Tag="next-layout" Click="_TmuxActionClicked" />
                                            <MenuFlyoutItem Text="查看滚动历史" Tag="copy-mode" Click="_TmuxActionClicked" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="TmuxRailTranslate" Width="40" Height="40" Margin="4" Click="_TmuxTranslateClicked" IsEnabled="False"
                                        Style="{ThemeResource TmuxSubtleButtonStyle}" AutomationProperties.Name="AI 翻译" ToolTipService.ToolTip="AI 翻译">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="16" />
                                </Button>
                            <Button Width="40" Height="40" Margin="4,4,4,12" Click="_TmuxPersonalizationClicked"
                                    Style="{ThemeResource TmuxSubtleButtonStyle}" AutomationProperties.Name="个性化"
                                    ToolTipService.ToolTip="个性化"><FontIcon Glyph="&#xE713;" FontSize="16" /></Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </SplitView.Pane>
            <SplitView.Content>
                <Grid>
                    <Grid x:Name="TabContent"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.Background>
                            <ImageBrush />
                        </Grid.Background>
                    </Grid>

                    <Grid x:Name="TmuxEmptyWorkspace"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="32" Spacing="12">
                            <FontIcon Glyph="&#xE8A5;" FontSize="32" HorizontalAlignment="Center" />
                            <TextBlock Text="选择会话" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="从侧边栏打开会话，或创建一个新会话。"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </SplitView.Content>
        </SplitView>

        <!-- This edge sits above both acrylic surfaces and always stays opaque. -->
        <Border x:Name="TmuxSidebarDivider" Grid.Row="2" Grid.ColumnSpan="2" Width="1" Margin="280,0,0,0"
                HorizontalAlignment="Left" Background="{ThemeResource TmuxSidebarEdgeBrush}" IsHitTestVisible="False"
                Visibility="{Binding Visibility, ElementName=TmuxWorkspaceView}" />

        <Grid x:Name="TmuxServerPicker" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid MaxWidth="800" Margin="32" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="服务器" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Click="_TmuxAddServerClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="添加服务器" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" Text="选择服务器以连接并管理会话。" Margin="0,0,0,24"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Grid Grid.Row="2">
                    <ListView x:Name="TmuxServerList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="_TmuxServerClicked" HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="已保存和本机 SSH 配置中的服务器">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <StackPanel x:Name="TmuxNoServers" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                        <FontIcon Glyph="&#xE968;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="添加第一台服务器" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="粘贴 SSH 指令即可添加。本机 SSH 配置中的服务器会自动显示在这里。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TmuxHomeStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1" Click="_TmuxPersonalizationClicked" Style="{ThemeResource TmuxSubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="个性化" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <ContentDialog x:Name="TmuxAddServerDialog" Grid.Row="2" Grid.ColumnSpan="2"
                       Title="添加服务器" PrimaryButtonText="添加并连接" CloseButtonText="取消"
                       DefaultButton="Primary" IsPrimaryButtonEnabled="False">
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MinWidth="300" MaxWidth="460" Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="TmuxSshCommand" Header="SSH 指令或主机" PlaceholderText="ssh user@host -p 22"
                                 MaxLength="4096" TextChanged="_TmuxSshCommandChanged" />
                        <TextBlock Text="自动使用此电脑的 SSH 配置和可用密钥。" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="TmuxConnectionPreview" Padding="16" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="连接信息" FontWeight="SemiBold" />
                            <TextBlock x:Name="TmuxCommandSummary" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TmuxServerError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <mux:Expander Header="更多选项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <TextBox x:Name="TmuxServerLabel" Header="名称（可选）" PlaceholderText="例如：开发服务器"
                                     MaxLength="80" TextChanged="_TmuxDetailsChanged" />
                            <TextBox x:Name="TmuxHost" Header="主机或 SSH 别名" MaxLength="253" TextChanged="_TmuxDetailsChanged" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="TmuxUser" Header="用户名" PlaceholderText="使用 SSH 配置"
                                         Margin="0,0,12,0" MaxLength="128" TextChanged="_TmuxDetailsChanged" />
                                <TextBox x:Name="TmuxPort" Grid.Column="1" Header="端口" PlaceholderText="自动"
                                         MaxLength="5" TextChanged="_TmuxDetailsChanged" />
                            </Grid>
                            <TextBox x:Name="TmuxIdentity" Header="私钥文件（可选）" PlaceholderText="使用默认密钥或 ssh-agent"
                                     TextChanged="_TmuxDetailsChanged" />
                            <TextBox x:Name="TmuxJumpHost" Header="跳板机（可选）" PlaceholderText="SSH 别名或 user@host:port"
                                     TextChanged="_TmuxDetailsChanged" />
                            <TextBox x:Name="TmuxConfigFile" Header="SSH 配置文件（可选）" PlaceholderText="使用此电脑的默认配置"
                                     TextChanged="_TmuxDetailsChanged" />
                        </StackPanel>
                    </mux:Expander>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="TmuxPersonalizationDialog" Grid.Row="2" Grid.ColumnSpan="2"
                       Title="个性化" PrimaryButtonText="保存" CloseButtonText="取消" DefaultButton="Primary">
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MinWidth="300" MaxWidth="460" Spacing="16">
                    <ComboBox x:Name="TmuxTheme" Header="应用主题" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="TmuxColorScheme" Header="终端配色" HorizontalAlignment="Stretch" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="TmuxFontFace" Header="终端字体" Margin="0,0,12,0" PlaceholderText="Cascadia Mono" />
                        <mux:NumberBox x:Name="TmuxFontSize" Grid.Column="1" Header="字号" Minimum="8" Maximum="40"
                                       SmallChange="1" SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <ToggleSwitch x:Name="TmuxAcrylic" Header="背景半透明材质" OnContent="开" OffContent="关" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="背景不透明度" />
                        <Slider x:Name="TmuxOpacity" Minimum="20" Maximum="100" StepFrequency="1" TickFrequency="10"
                                AutomationProperties.Name="背景不透明度" />
                        <TextBlock Text="应用到服务器列表、侧栏和终端，数值越低越透明。保存后生效。"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBox x:Name="TmuxBackgroundImage" Header="终端背景图片" PlaceholderText="不使用背景图片" />
                        <Button Content="选择图片" Click="_TmuxBrowseBackgroundClicked" />
                    </StackPanel>
                    <TextBlock x:Name="TmuxPersonalizationError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="TmuxNewSessionDialog" Grid.Row="2" Grid.Column="1"
                       Title="新建会话" PrimaryButtonText="创建并打开" CloseButtonText="取消"
                       DefaultButton="Primary" IsPrimaryButtonEnabled="False">
            <StackPanel MinWidth="300" MaxWidth="420" Spacing="8">
                <TextBox x:Name="TmuxNewSessionName" Header="会话名称" PlaceholderText="例如 dev、training、logs"
                         MaxLength="80" TextChanged="_TmuxNewNameChanged" />
                <TextBlock x:Name="TmuxNameValidation" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>

        <!--
            GH#12775 et. al: After switching to ControlsV2, it seems that
            delay-loading a dialog causes the ContentDialog to be assigned a
            Height equal to its content size. If we DON'T assign the
            ContentDialog a Row, I believe it's assigned Row 0 by default. So,
            when the dialog gets opened, the dialog seemingly causes a giant
            hole to appear in the body of the app.
            
            Assigning all the dialogs to Row 2 (where the rest of the content
            is) makes the "hole" appear in the same space as the rest of the
            TabContent, fixing the issue.
            
            Note that the actual content in a content dialog gets parented to
            the PopupRoot, so it actually always appeared in the correct place, it's
            just this weird hole that appeared in Row 0.
        -->

        <local:AboutDialog x:Name="AboutDialog"
                           Grid.Row="2"
                           Grid.Column="1"
                           x:Load="False" />

        <ContentDialog x:Name="QuitDialog"
                       x:Uid="QuitDialog"
                       Grid.Row="2"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary" />

        <ContentDialog x:Name="CloseAllDialog"
                       x:Uid="CloseAllDialog"
                       Grid.Row="2"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary" />

        <ContentDialog x:Name="CloseReadOnlyDialog"
                       x:Uid="CloseReadOnlyDialog"
                       Grid.Row="2"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Close" />

        <ContentDialog x:Name="MultiLinePasteDialog"
                       x:Uid="MultiLinePasteDialog"
                       Grid.Row="2"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary">
            <StackPanel>
                <TextBlock x:Uid="MultiLineWarningText"
                           TextWrapping="Wrap" />
                <TextBlock x:Uid="ClipboardTextHeader"
                           Margin="0,16,0,0" />
                <ScrollViewer x:Name="ClipboardContentScrollViewer"
                              MaxHeight="100"
                              Margin="0,8,0,0">
                    <TextBlock x:Name="ClipboardText"
                               FontFamily="Cascadia Mono"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="LargePasteDialog"
                       x:Uid="LargePasteDialog"
                       Grid.Row="2"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary" />

        <ContentDialog x:Name="ControlNoticeDialog"
                       x:Uid="ControlNoticeDialog"
                       Grid.Row="2"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary">
            <TextBlock IsTextSelectionEnabled="True"
                       TextWrapping="WrapWholeWords">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
                <Run x:Name="NoticeMessage" />
            </TextBlock>
        </ContentDialog>

        <ContentDialog x:Name="UriErrorDialog"
                       x:Uid="UriErrorDialog"
                       Grid.Row="2"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Close">
            <TextBlock IsTextSelectionEnabled="True"
                       TextWrapping="WrapWholeWords">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
                <Run x:Name="CouldNotOpenUriReason" /> <LineBreak /> <LineBreak />
                <Run x:Name="UnopenedUri"
                     FontFamily="Cascadia Mono" />
            </TextBlock>
        </ContentDialog>

        <local:CommandPalette x:Name="CommandPaletteElement"
                              Grid.Row="2"
                              Grid.Column="1"
                              VerticalAlignment="Stretch"
                              x:Load="False"
                              PreviewKeyDown="_KeyDownHandler"
                              Visibility="Collapsed" />

        <local:SuggestionsControl x:Name="SuggestionsElement"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  x:Load="False"
                                  PreviewKeyDown="_KeyDownHandler"
                                  Visibility="Collapsed" />

        <!--
            A TeachingTip with IsLightDismissEnabled="True" will immediately
            dismiss itself if the window is unfocused (In Xaml Islands). This is
            tracked by MUX#4382
        -->
        <mux:TeachingTip x:Name="WindowIdToast"
                         Title="{x:Bind WindowProperties.WindowIdForDisplay}"
                         x:Load="False"
                         IsLightDismissEnabled="True"
                         Subtitle="{x:Bind WindowProperties.WindowNameForDisplay, Mode=OneWay}" />

        <mux:TeachingTip x:Name="WindowRenamer"
                         x:Uid="WindowRenamer"
                         Title="{x:Bind WindowProperties.WindowIdForDisplay}"
                         x:Load="False"
                         ActionButtonClick="_WindowRenamerActionClick"
                         ActionButtonStyle="{ThemeResource AccentButtonStyle}"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <TextBox x:Name="WindowRenamerTextBox"
                         KeyDown="_WindowRenamerKeyDown"
                         KeyUp="_WindowRenamerKeyUp"
                         Text="{x:Bind WindowProperties.WindowName, Mode=OneWay}">
                    <TextBox.ContextFlyout>
                        <mtu:TextMenuFlyout />
                    </TextBox.ContextFlyout>
                </TextBox>
            </mux:TeachingTip.Content>
        </mux:TeachingTip>

        <mux:TeachingTip x:Name="WindowCwdToast"
                         x:Uid="WindowCwdToast"
                         Title="{x:Bind WindowProperties.VirtualWorkingDirectory, Mode=OneWay}"
                         x:Load="False"
                         IsLightDismissEnabled="True" />

        <mux:TeachingTip x:Name="ActionSavedToast"
                         x:Uid="ActionSavedToast"
                         Title="Action Saved"
                         HorizontalAlignment="Stretch"
                         x:Load="False"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical">
                    <TextBlock x:Name="ActionSavedNameText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionName), Mode=OneWay}">
                        <Run Text="Name: " />
                        <Run Text="{x:Bind SavedActionName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ActionSavedKeyChordText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionKeyChord), Mode=OneWay}">
                        <Run Text="Key Chord: " />
                        <Run Text="{x:Bind SavedActionKeyChord, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ActionSavedCommandLineText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionCommandLine), Mode=OneWay}">
                        <Run Text="Input: " />
                        <Run Text="{x:Bind SavedActionCommandLine, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </mux:TeachingTip.Content>
        </mux:TeachingTip>
        <mux:TeachingTip x:Name="ActionSaveFailedToast"
                         x:Uid="ActionSaveFailedToast"
                         Title="Action Save Failed"
                         x:Load="False"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <TextBlock x:Name="ActionSaveFailedMessage"
                           Text="" />
            </mux:TeachingTip.Content>
        </mux:TeachingTip>
        <ContentDialog x:Name="TmuxTranslationDialog" Title="AI 翻译" PrimaryButtonText="翻译并输入" CloseButtonText="取消"
                       Grid.Row="2" Grid.Column="1" IsPrimaryButtonEnabled="False">
            <StackPanel Spacing="12">
                <TextBlock Text="译文填入当前终端，按 Enter 发送。只发送这里填写的原文到你的 API。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="TmuxTranslationText" Header="原文" PlaceholderText="输入需要翻译的文字"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" MaxLength="16000"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="_TmuxTranslationChanged" />
                <TextBox x:Name="TmuxTranslationLanguage" Header="目标语言" PlaceholderText="例如英语、日语、简体中文" MaxLength="80" TextChanged="_TmuxTranslationChanged" />
                <mux:Expander x:Name="TmuxTranslationApi" Header="API 设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBox x:Name="TmuxTranslationEndpoint" Header="API 地址" PlaceholderText="https://你的服务商/v1" TextChanged="_TmuxTranslationChanged" />
                        <TextBox x:Name="TmuxTranslationModel" Header="模型名称" PlaceholderText="填写服务商提供的模型 ID" MaxLength="200" TextChanged="_TmuxTranslationChanged" />
                        <PasswordBox x:Name="TmuxTranslationKey" Header="API Key" PlaceholderText="本机无需密钥的服务可留空" PasswordChanged="_TmuxTranslationKeyChanged" />
                        <TextBlock Text="支持 OpenAI 兼容的 Chat Completions 接口。密钥用当前 Windows 用户加密保存。"
                                   TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </mux:Expander>
                <ProgressBar x:Name="TmuxTranslationProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="TmuxTranslationStatus" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ContentDialog>

        <!-- Editable forms stay inside the main XAML Island. ContentDialog's
             separate popup input surface is unsupported by that host. -->
        <Grid x:Name="TmuxInputLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#66000000" TabFocusNavigation="Cycle">
            <Border x:Name="TmuxInputCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24" MaxWidth="560" MinWidth="340" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="TmuxInputTitle" Margin="24,24,24,16" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,0,24,24">
                        <ContentPresenter x:Name="TmuxInputBody" />
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="24" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="TmuxInputPrimary" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Margin="0,0,8,0" />
                            <Button x:Name="TmuxInputClose" Grid.Column="1" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
